@model IEnumerable<CourtDiary.Models.Case>
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                @* <h1 class="m-0 text-dark">Dashboard</h1> *@
            </div>

        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!-- Top Boxes -->
        <div class="row">
            @{
                var dashboardData = new List<dynamic>
                {
                    new { Title = "Total Active Cases", Count = ViewBag.TotalActiveCases, BgColor = "bg-info", Icon = "fas fa-balance-scale", Controller = "Cases" },
                    new { Title = "Total Cases", Count = ViewBag.TotalCases, BgColor = "bg-primary", Icon = "fas fa-briefcase", Controller = "Cases" },
                    new { Title = "Today Hearing", Count = ViewBag.TodayHearings, BgColor = "bg-success", Icon = "fas fa-gavel", Controller = "Hearings" },
                    new { Title = "Total Hearing", Count = ViewBag.TotalHearings, BgColor = "bg-secondary", Icon = "fas fa-gavel", Controller = "Hearings" },
                    new { Title = "Today Meeting", Count = ViewBag.TodayMeetings, BgColor = "bg-warning", Icon = "fas fa-users", Controller = "Meetings" },
                    new { Title = "Pending Payments", Count = ViewBag.PendingPayments, BgColor = "bg-danger", Icon = "fas fa-dollar-sign", Controller = "Cases" } // Assuming cases for pending payments
                };
            }

            @foreach (var item in dashboardData)
            {
                <div class="col-lg-3 col-6">
                    <div class="small-box @item.BgColor">
                        <div class="inner">
                            <h3>@item.Count</h3>
                            <p>@item.Title</p>
                        </div>
                        <div class="icon">
                            <i class="@item.Icon"></i>
                        </div>
                        <a href="@Url.Action("Index", (string)item.Controller)" class="small-box-footer">
                            More info <i class="fas fa-arrow-circle-right"></i>
                        </a>
                    </div>
                </div>
            }
  
</section>


